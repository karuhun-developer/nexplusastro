---
import Kicker from '@/components/atoms/Kicker.astro';
import Panel from '@/components/atoms/Panel.astro';
import LinkButton from '@/components/atoms/LinkButton.astro';
import '@/styles/global.css';
---
<html lang="id"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><title>NEX+ primitives</title></head><body><main class="container-nex space-y-8 py-16"><Kicker>Design system</Kicker><h1 class="text-title">NEX+ primitives</h1><Panel class="space-y-6 p-8"><h2 class="text-section">Koneksi yang tepat.</h2><p class="text-muted">General Sans dan Switzer. Komponen mengikuti token NEX+.</p><div class="flex flex-wrap gap-4"><LinkButton href="#field">Primary action</LinkButton><LinkButton href="#field" variant="outline">Secondary action</LinkButton><LinkButton href="#field" variant="link">Text action</LinkButton></div><label class="block" for="field">Lokasi</label><input id="field" class="field-control" placeholder="Banjarmasin Tengah"/></Panel></main></body></html>
