---
import SiteLayout from '@/layouts/SiteLayout.astro';
import SectionHeading from '@/components/molecules/SectionHeading.astro';
import Breadcrumbs from '@/components/molecules/Breadcrumbs.astro';
import { SpeedTest } from '@/components/organisms/SpeedTest';
const breadcrumbs = [{ label: 'Uji Kecepatan' }];
---

<SiteLayout
  title="Uji Kecepatan Koneksi"
  description="Ukur unduh, unggah, dan latensi HTTP koneksi Anda ke jaringan publik Cloudflare, dengan batas waktu, kuota data, dan tombol pembatalan."
  breadcrumbs={breadcrumbs}
>
  <section class="container-nex py-12 lg:py-20">
    <Breadcrumbs items={breadcrumbs} />
    <SectionHeading
      page
      kicker="Uji Kecepatan"
      title="Kenali koneksi
yang Anda gunakan."
      description="Ukur unduh, unggah, dan latensi ke server publik Cloudflare. Hasil membantu melihat kondisi koneksi saat ini."
    />
    <SpeedTest client:load />
  </section>
</SiteLayout>
