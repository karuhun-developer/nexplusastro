---
import SiteLayout from '@/layouts/SiteLayout.astro';
import SectionHeading from '@/components/molecules/SectionHeading.astro';
import Breadcrumbs from '@/components/molecules/Breadcrumbs.astro';
import TrafficChart from '@/components/molecules/TrafficChart.astro';
import {MonitoringLinks} from '@/components/organisms/MonitoringLinks';
import {MonitoringClock} from '@/components/organisms/MonitoringClock';
import {fleet,focusNode,resources,incidents,monitoringMeta} from '@/lib/monitoring';
const breadcrumbs=[{label:'Demo Monitoring'}];
---
<SiteLayout title="Demo Monitoring Jaringan" description="Jelajahi tampilan contoh pemantauan jaringan NEX+. Semua perangkat, angka, dan insiden adalah data demonstrasi." noindex breadcrumbs={breadcrumbs}><section class="container-nex py-12 lg:py-16"><Breadcrumbs items={breadcrumbs}/><SectionHeading page kicker="Managed Services" title="Lihat jaringan Anda,
bukan menebaknya." description="Jelajahi contoh dashboard status tautan, lalu lintas, dan insiden untuk layanan monitoring."/><div class="mb-6 flex flex-wrap items-center justify-between gap-4"><p class="font-display text-lg">{monitoringMeta.product} <span class="ml-2 rounded-lg bg-raised px-3 py-2 font-sans text-xs">Contoh</span></p><MonitoringClock client:visible/></div><p class="mb-6 rounded-control border border-rule bg-surface p-5 text-sm text-muted" role="note"><strong class="text-ink">Tampilan contoh.</strong> Semua angka, perangkat, dan insiden dibuat untuk demonstrasi. Data tetap: {monitoringMeta.observedAt}. Tidak terhubung ke jaringan NEX+.</p><dl class="grid grid-cols-2 gap-4 lg:grid-cols-4">{[{label:'Perangkat online',value:fleet.online+'/'+fleet.total},{label:'Insiden terbuka',value:fleet.incidentsOpen},{label:'Selesai dalam 24 jam',value:fleet.incidentsResolved24h},{label:'Sesi aktif',value:fleet.sessions}].map(s=><div class="glass p-5 sm:p-6"><dt class="text-xs text-muted">{s.label}</dt><dd class="mt-4 font-display text-3xl">{s.value}</dd><span class="mt-2 block text-[10px] text-muted">Data contoh</span></div>)}</dl><div class="mt-6 grid items-start gap-6 lg:grid-cols-[1.6fr_1fr]"><div class="space-y-6"><section class="glass p-6 sm:p-8"><div class="flex flex-wrap justify-between gap-4"><div><h2 class="text-xl">Lalu lintas jaringan</h2><p class="mt-2 text-xs text-muted">{focusNode.name} · {focusNode.address}</p></div><div class="flex gap-4 text-xs"><span class="text-accent-text">— Masuk</span><span class="text-muted">- - Keluar</span></div></div><TrafficChart/><p class="mt-4 text-xs text-muted">Mbps · {focusNode.interfaceName} · {monitoringMeta.source}</p></section><MonitoringLinks client:visible/></div><div class="space-y-6"><section class="glass p-6"><h2 class="text-xl">Insiden kritis</h2><p class="mt-4 text-accent-text">Core Router 02</p><p class="mt-2 text-sm text-muted">Perangkat keras tidak merespons. Terdaftar pada 09:12 WITA, contoh 12 jam lalu.</p><p class="mt-5 border-t border-rule pt-4 text-xs text-muted">Perangkat inti lainnya berjalan normal.</p></section><section class="glass p-6"><h2 class="text-xl">Sumber daya</h2><dl class="mt-6 space-y-6">{resources.map(r=><div><div class="flex justify-between gap-4 text-xs"><dt class="text-muted">{r.label}</dt><dd>{r.value}% {r.unit}</dd></div><progress max="100" value={r.value} aria-label={r.label} class="mt-3 h-2 w-full accent-action"/></div>)}</dl></section><section class="glass p-6"><h2 class="text-xl">Riwayat insiden</h2><ol class="mt-4">{incidents.map(i=><li class="border-t border-rule py-4"><span class="text-xs text-muted">{i.time} WITA</span><h3 class="mt-2 text-sm">{i.title}</h3><span class:list={['mt-2 block text-xs',i.status==='open'?'text-accent-text':'text-good']}>{i.status==='open'?'Terbuka':'Selesai'}</span></li>)}</ol></section></div></div></section></SiteLayout>
