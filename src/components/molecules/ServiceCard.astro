---
import type { Service } from '@/lib/content';
import { ServiceDiagram } from '../art/ServiceDiagram';
import LinkButton from '../atoms/LinkButton.astro';
interface Props { service:Service; class?:string; compact?:boolean; }
const {service,class:className='',compact=false}=Astro.props;
---
<article id={'service-'+service.id} class:list={['glass relative overflow-hidden p-6 sm:p-8',className]} data-reveal><div class="relative z-10"><div class="mb-8 flex justify-between text-xs tracking-widest text-muted"><span>{service.category}</span><span>{service.number}</span></div><div class:list={[compact?'grid grid-cols-[1fr_100px] items-center gap-3':'grid gap-3 sm:grid-cols-[1fr_160px]']}><div><h3 class="text-2xl leading-tight">{service.title}</h3><p class="mt-4 max-w-[38ch] text-sm text-muted">{service.description}</p></div><ServiceDiagram service={service}/></div><div class="mt-6 flex flex-wrap items-center gap-2 text-[10px] tracking-widest text-muted">{service.endpoints.map((e,i)=><><span class="rounded-lg border border-rule px-3 py-2">{e}</span>{i<service.endpoints.length-1&&<span aria-hidden="true">→</span>}</>)}</div><div class="mt-6"><LinkButton href={'/solutions/'+service.id} variant="link" diagonal>Lihat layanan</LinkButton></div></div></article>
