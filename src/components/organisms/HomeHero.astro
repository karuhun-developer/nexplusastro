---
import {credentials} from '@/lib/content';
import {NetworkArt} from '../art/NetworkArt';
import Kicker from '../atoms/Kicker.astro';
import LinkButton from '../atoms/LinkButton.astro';
---
<section class="container-nex pt-12 pb-12 lg:pt-16 lg:pb-20" aria-labelledby="hero-heading"><div class="grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-center lg:gap-8"><div><Kicker>Konektivitas Enterprise</Kicker><h1 id="hero-heading" class="text-hero leading-[1.07] tracking-[-.055em]"><span class="block">Empowering</span><span class="block">business with</span><span class="block">smart connectivity.</span></h1><p class="mt-6 max-w-[46ch] text-muted lg:text-[1.0625rem]">Konektivitas internet dan infrastruktur telekomunikasi untuk perusahaan, institusi, dan hospitality.</p><div class="mt-8 flex flex-wrap gap-3"><LinkButton href="#kebutuhan">Temukan Solusi</LinkButton><LinkButton href="/contact" variant="outline" diagonal>Konsultasi</LinkButton></div></div><figure class="relative isolate aspect-[1.05] overflow-hidden rounded-panel lg:row-span-1" aria-label="Ilustrasi rak server dan koneksi jaringan NEX+"><div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_center,var(--glow-strong),transparent_65%)]"></div><div class="absolute inset-0 -z-10 bg-[linear-gradient(var(--grid)_1px,transparent_1px),linear-gradient(90deg,var(--grid)_1px,transparent_1px)] bg-[size:32px_32px] [mask-image:radial-gradient(ellipse,black,transparent_70%)]"></div><svg class="absolute inset-0 size-full" viewBox="0 0 560 540" fill="none" aria-hidden="true"><path stroke="var(--rule)" d="M0 130h125l80 80h170l65-65h120M0 375h100l100-100h180l75 75h105M120 0v90l160 160v290"/><path stroke="var(--color-accent)" stroke-opacity=".5" d="M0 375h100l100-100h180l75 75h105M125 130l80 80h170l65-65"/><g fill="var(--color-accent)"><circle cx="100" cy="375" r="4"/><circle cx="440" cy="145" r="4"/><circle cx="455" cy="350" r="4"/></g></svg><span class="absolute top-4 left-6 text-[10px] uppercase tracking-[.2em] text-muted">NEX+ / Infrastructure</span><NetworkArt variant="data-center" className="absolute inset-[10%] size-4/5"/><span class="glass absolute top-[28%] right-0 rounded-lg px-3 py-2 text-[10px]">Dedicated Internet</span><span class="glass absolute bottom-[20%] left-0 rounded-lg px-3 py-2 text-[10px]">Metro E</span><figcaption class="absolute right-6 bottom-4 text-xs text-muted">Terhubung untuk tumbuh.</figcaption></figure><div class="row-start-2 border-y border-rule py-6 lg:col-span-2 lg:row-start-auto"><p class="mb-4 text-[10px] uppercase tracking-[.18em] text-muted">Rekam jejak NEX+</p><ul class="grid grid-cols-3 gap-4">{credentials.map(c=><li class="flex flex-col gap-2 lg:flex-row lg:items-center lg:gap-5"><span class="font-display text-2xl lg:text-3xl">{c.value}</span><span class="max-w-[22ch] text-xs text-muted">{c.label}</span></li>)}</ul></div></div></section>
