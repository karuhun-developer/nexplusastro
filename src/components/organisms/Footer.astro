---
import Brand from '../atoms/Brand.astro';
import { company, services } from '@/lib/content';
const columns = [
  {
    title: 'Perusahaan',
    links: [
      { label: 'Tentang NEX+', href: '/#journey' },
      { label: 'Pelanggan', href: '/#customers' },
      { label: 'Mitra', href: '/#partners' },
      { label: 'Infrastruktur', href: '/infrastructure' },
    ],
  },
  { title: 'Solusi', links: services.map((s) => ({ label: s.title, href: '/solutions/' + s.id })) },
  {
    title: 'Dukungan & Alat',
    links: [
      { label: 'Cek Cakupan', href: '/coverage' },
      { label: 'Kalkulator Bandwidth', href: '/bandwidth-calculator' },
      { label: 'Uji Kecepatan', href: '/speed-test' },
      { label: 'Demo Monitoring', href: '/monitoring' },
      { label: 'Kontak', href: '/contact' },
    ],
  },
];
---

<footer class="container-nex border-t border-rule pt-16 pb-8">
  <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <a href="/" aria-label="NEX+ beranda">
        <Brand />
      </a>
      <p class="mt-5 text-sm">{company.legalName}</p>
      <p class="mt-3 text-sm text-muted">
        Konektivitas dan infrastruktur
        <br />
        untuk kebutuhan bisnis Anda.
      </p>
      <address class="mt-5 grid gap-2 text-sm not-italic text-muted">
        <span class="text-xs uppercase tracking-widest">
          {company.contactIsPlaceholder ? 'Kontak contoh' : 'Kontak resmi'}
        </span>
        <span>{company.email}</span>
        <span>{company.phone}</span>
      </address>
    </div>
    {columns.map((c) => (
      <nav aria-label={c.title}>
        <h2 class="mb-5 text-sm font-semibold tracking-normal">{c.title}</h2>
        <ul class="space-y-1">
          {c.links.map((n) => (
            <li>
              <a
                href={n.href}
                class="inline-flex min-h-11 items-center text-sm text-muted hover:text-ink"
              >
                {n.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <div class="mt-12 flex flex-wrap justify-between gap-4 border-t border-rule pt-6 text-xs text-muted">
    <span>
      © {new Date().getFullYear()} {company.legalName}
    </span>
    <a href="#top" class="inline-flex min-h-11 items-center">
      Kembali ke atas ↑
    </a>
  </div>
</footer>
