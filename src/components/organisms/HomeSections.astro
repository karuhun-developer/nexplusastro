---
import {services,milestones,excellence} from '@/lib/content';
import {customerLogos,partnerLogos} from '@/lib/logos';
import SectionHeading from '../molecules/SectionHeading.astro';
import ServiceCard from '../molecules/ServiceCard.astro';
import Kicker from '../atoms/Kicker.astro';
import LinkButton from '../atoms/LinkButton.astro';
const needs=[services[0],services[3],services[1],services[2]];
const featuredNames=['Novotel','Swiss-Belhotel Borneo Banjarmasin','Harper Banjarmasin Kalimantan by Aston','RSUD Sultan Suriansyah','Universitas Cahaya Bangsa','PUPR','Komdigi Kabupaten Tabalong','PT. Air Minum Intan Banjar (Perseroda)'];
const featured=customerLogos.filter(l=>featuredNames.includes(l.name));
const teasers=[{kicker:'Managed Services',title:`Lihat jaringan Anda,
bukan menebaknya.`,description:'Status tiap tautan, lalu lintas, dan insiden yang sedang ditangani — jelajahi contoh tampilan pemantauan layanan NEX+.',href:'/monitoring',cta:'Lihat Selengkapnya'},{kicker:'Responsif di Ponsel',title:`Pantau dari mana saja,
bukan cuma dari meja kerja.`,description:'Halaman pemantauan yang sama tetap terbaca rapi di ponsel Anda — tidak perlu aplikasi terpisah.',href:'/monitoring',cta:'Lihat Selengkapnya'},{kicker:'NEX+ Ecosystem',title:`Dari pusat data,
sampai ke bisnis Anda.`,description:'Kenali alur konektivitas yang menghubungkan Cyber 2 Jakarta, neuCentrIX Banjarmasin, dan bisnis Anda.',href:'/infrastructure',cta:'Lihat ekosistem'}];
---
<div class="space-y-20 pb-20 lg:space-y-28 lg:pb-28">
<section id="kebutuhan" class="container-nex"><SectionHeading kicker="Solusi untuk Bisnis" title="Koneksi yang tepat.
Untuk kebutuhan Anda." description="Dari akses internet hingga pengelolaan jaringan, temukan layanan yang mendukung bisnis Anda."/><div class="grid gap-4 md:grid-cols-12">{needs.map((s,i)=>s&&<ServiceCard service={s} class={i===0?'md:col-span-7':i===1?'md:col-span-5':'md:col-span-6'}/>)}</div><div class="mt-6 flex justify-end"><LinkButton href="/solutions" variant="link">Jelajahi semua solusi</LinkButton></div></section>
<section class="container-nex"><div class="glass grid gap-8 p-6 sm:p-10 lg:grid-cols-[1.5fr_1fr] lg:items-center" data-reveal><div><Kicker>Cek Ketersediaan</Kicker><h2 class="text-section leading-tight">Layanan kami sampai<br/>ke lokasi Anda?</h2><p class="mt-5 max-w-[58ch] text-sm text-muted">Ketersediaan tiap lokasi dipastikan langsung oleh tim NEX+, bukan lewat peta cakupan otomatis — tulis lokasi Anda dan pertanyaannya kami susun untuk tim.</p></div><div class="lg:justify-self-end"><LinkButton href="/coverage">Cek cakupan lokasi</LinkButton></div></div></section>
<section id="customers" class="container-nex"><SectionHeading kicker="Pelanggan NEX+" title="Dipercaya lintas
bidang usaha." description="Lebih dari 20 perusahaan terlayani hingga Q3 2025. Berikut sebagian pelanggan yang menjadi bagian dari perjalanan NEX+."/><div class="marquee overflow-hidden border-y border-rule py-8"><div class="marquee-track flex w-max">{[false,true].map(copy=><div class="flex shrink-0 items-center gap-12 pr-12 lg:gap-20 lg:pr-20" aria-hidden={copy?'true':undefined}>{featured.map(l=><img src={l.src} alt={copy?'':l.name} width={l.width} height={l.height} loading="lazy" decoding="async" class="logo-mono h-12 w-32 object-contain lg:h-14 lg:w-40"/>)}</div>)}</div></div><button type="button" data-marquee-toggle aria-pressed="false" class="mt-3 min-h-11 text-xs text-muted hover:text-ink">Jeda animasi</button></section>
<section class="container-nex grid gap-10 lg:grid-cols-2 lg:gap-20"><div data-reveal><Kicker>Mengapa NEX+</Kicker><h2 class="text-section leading-tight">Layanan berjalan.<br/>Dukungan berlanjut.</h2><p class="mt-5 max-w-[45ch] text-muted">Dari pemantauan jaringan hingga kebutuhan bandwidth, dukungan menjadi bagian dari layanan NEX+.</p><div class="relative mt-8 max-w-96"><svg viewBox="0 0 400 180" fill="none" aria-hidden="true"><path stroke="var(--rule)" d="M50 40h65l55 50h60l55-50h65M50 140h65l55-50h60l55 50h65"/><g fill="var(--color-accent)"><circle cx="50" cy="40" r="5"/><circle cx="350" cy="40" r="5"/><circle cx="50" cy="140" r="5"/><circle cx="350" cy="140" r="5"/></g></svg><img class="absolute top-1/2 left-1/2 size-14 -translate-1/2" src="/favicon.svg" alt="" width="64" height="64" loading="lazy"/></div></div><dl data-reveal>{excellence.map((e,i)=><div class="border-b border-rule py-6 first:pt-0"><dt class="flex items-center gap-6 font-display text-xl"><span class="text-xs text-accent-text">0{i+1}</span>{e.title}</dt><dd class="mt-3 pl-10 text-sm text-muted">{e.description}</dd></div>)}</dl></section>
<section class="container-nex grid gap-4 md:grid-cols-3" aria-label="Sorotan fitur NEX+">{teasers.map(t=><article class="glass flex flex-col p-6 lg:p-8" data-reveal><Kicker>{t.kicker}</Kicker><h2 class="whitespace-pre-line text-[1.375rem] leading-tight">{t.title}</h2><p class="mt-5 mb-6 text-sm text-muted">{t.description}</p><LinkButton href={t.href} variant="link" diagonal class="mt-auto text-sm">{t.cta}</LinkButton></article>)}</section>
<section id="journey" class="container-nex"><SectionHeading kicker="Tentang NEX+" title="Berawal dari rumah.
Tumbuh bersama bisnis." description="Perjalanan NEX+ dimulai pada 2018. Dari layanan internet rumahan, kami berkembang untuk menjawab kebutuhan konektivitas perusahaan di Kalimantan Selatan."/><ol id="journey-timeline" class="grid gap-8 border-t border-rule pt-8 sm:grid-cols-2 lg:grid-cols-4">{milestones.map(m=><li data-reveal><span class="font-display text-4xl text-accent-text">{m.year}</span><h3 class="mt-6 text-xl">{m.title}</h3><p class="mt-3 text-sm text-muted">{m.description}</p></li>)}</ol></section>
<section id="partners" class="container-nex"><div class="grid gap-8 lg:grid-cols-[1fr_2fr] lg:items-center"><div data-reveal><Kicker>Mitra NEX+</Kicker><h2 class="text-section leading-tight">Mitra dalam<br/>satu ekosistem.</h2><p class="mt-5 text-sm text-muted">Kolaborasi untuk kebutuhan konektivitas dan infrastruktur.</p></div><div class="grid grid-cols-3 items-center gap-8 sm:grid-cols-4">{partnerLogos.map(l=><img src={l.src} alt={l.name} width={l.width} height={l.height} loading="lazy" decoding="async" class="logo-mono h-12 w-full object-contain"/>)}</div></div></section>
<section id="contact" class="container-nex"><div class="relative overflow-hidden border-t border-rule pt-14" data-reveal><svg class="pointer-events-none absolute top-0 right-0 -z-10 w-1/2 opacity-40" viewBox="0 0 500 420" fill="none" stroke="var(--rule)" aria-hidden="true"><path d="M500 10H280L40 250v170M500 70H300L100 270v150M500 130H320L160 290v130M500 190H340L220 310v110"/></svg><Kicker>Mari Terhubung</Kicker><h2 class="max-w-4xl text-section leading-tight lg:text-[3.5rem]">Bangun infrastruktur<br/>konektivitas yang lebih andal.</h2><div class="mt-10 flex flex-wrap items-end justify-between gap-8"><p class="text-muted">Ceritakan kebutuhan bisnis Anda.<br/>Mari tentukan koneksi yang tepat bersama NEX+.</p><div class="grid gap-3"><LinkButton href="/contact" diagonal>Konsultasikan kebutuhan</LinkButton><LinkButton href="/contact" variant="link" diagonal>Halaman kontak lengkap</LinkButton></div></div></div></section>
</div>
